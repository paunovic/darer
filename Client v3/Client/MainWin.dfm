      object lbTips: TspSkinStdLabel
        Left = 0
        Top = 112
        Width = 508
        Height = 110
        Cursor = crArrow
        EllipsType = spetNone
        UseSkinFont = True
        UseSkinColor = True
        DefaultFont.Charset = DEFAULT_CHARSET
        DefaultFont.Color = clWhite
        DefaultFont.Height = -11
        DefaultFont.Name = 'Tahoma'
        DefaultFont.Style = []
        SkinDataName = 'stdlabel'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWhite
        Font.Height = -11
        Font.Name = 'Tahoma'
        Font.Style = []
        Align = alBottom
        AutoSize = False
        Caption = 
          'TIPS'#13#10#13#10'1. Paste the promo message to ALL CHAT and get 10 extra ' +
          'rating. The message is auto copied when the game starts, you jus' +
          't need to paste it.'#13#10'2. Only 5x5 games in Garena, iCCup, RGC, DL' +
          'G and Battle.net count'#13#10'3. Always run Warcraft III through the p' +
          'latform itself ("Start Game" button in Garena, etc)'
        ParentFont = False
        Layout = tlCenter
        WordWrap = True
        OnClick = lbTipsClick
        ExplicitTop = 63
      end
      object lbHowItWorks: TspSkinStdLabel
        Left = 0
        Top = 0
        Width = 508
        Height = 110
        Cursor = crHandPoint
        EllipsType = spetNone
        UseSkinFont = True
        UseSkinColor = True
        DefaultFont.Charset = DEFAULT_CHARSET
        DefaultFont.Color = clWhite
        DefaultFont.Height = -11
        DefaultFont.Name = 'Tahoma'
        DefaultFont.Style = []
        SkinDataName = 'stdlabel'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWhite
        Font.Height = -11
        Font.Name = 'Tahoma'
        Font.Style = []
        Align = alClient
        AutoSize = False
        Caption = 
          'HOW IT WORKS'#13#10#13#10'1. Run the client and login with your Darer acco' +
          'unt.'#13#10'2. Go to Battle.net, Garena, Iccup, DLG or RGC and start a' +
          ' game in the normal way.'#13#10'3. When the game starts paste the prom' +
          'o message so you get the 10 extra rating for the game.'#13#10'4. After' +
          ' the game, go to www.darer.com and check your statistics.'
        ParentFont = False
        Layout = tlCenter
        WordWrap = True
        OnClick = lbHowItWorksClick
        ExplicitHeight = 81
      end
    end
