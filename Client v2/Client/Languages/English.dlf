[commandstext]
H001 = MUST KNOW COMMANDS
0002 = 
C003 = .start
0003 = Starts the game
0004 = 
H005 = IN CLIENT:
0006 = 
C007 = /msg, /whisper, /m, /w <name>
0007 = Send a message to the player
C008 = /ignore <name>
0008 = Ignore the player so he can't chat with you
C009 = /unignore <name>
0009 = Unignore the player
C010 = /who <channel>
0010 = Display all users in the selected channel
C011 = /stats <name>
0011 = Display basic player statistics
C012 = /channel, /join <name of channel>
0012 = Join specified channel
C013 = /rejoin
0013 = Rejoin the current channel in which you are
C014 = /uptime
0014 = Display the uptime of the server
C015 = /admins
0015 = Display the admins online
C016 = /reply, /r <msg>
0016 = Reply to the last whisper you have received
C017 = /ping, /latency, /p <player>
0017 = Display player's ping
0018 = 
H019 = IN GAME LOBBY:
0119 =
C020 = .close <number>
0020 = Close a slot
C021 = .closeall
0021 = Close all open slots
C022 = .hold <player>
0022 = Hold a slot for specified player
C023 = .swap <n1> <n2>
0023 = Swap slots
C024 = .open <number>
0024 = Open slot
C025 = .openall
0025 = Open all closed slotsslots
C026 = .sp
0026 = Shuffle players
C027 = .ss, .sb
0027 = Show ratings
C028 = .ab
0028 = Autobalance
C029 = .start
0029 = Start the game
C030 = .stats <name>
0030 = Display basic player statistics
C031 = .ping
0031 = Ping players
C032 = .unhost
0032 = Unhost game
0X33 =
H034 = IN GAME:
0X34 =
C035 = .ping
0035 = Ping players
C036 = .rmk
0036 = Start a vote to end the game without counting any stats
C037 = .stats <name>
0037 = Display basic player statistics
C137 = .mute <name>
0137 = Mute a player from the global chat (only available for the game host)
C237 = .unmute <name>
0237 = Unmute a player
C038 = .muteall
0038 = Mute the global chat
C039 = .unmuteall
0039 = Unmute global chat
C040 = .votekick <name>
0040 = Start a votekick for the chosen player
C041 = .votecancel
0041 = Cancel a votekick
C042 = .yes
0042 = Register a vote in the votekick
C043 = .from
0043 = Display the country each player is from
C044 = .dr <value>
0044 = Show or set latency (50-250)
C055 = /re <msg>
0055 = Answer to the last person who whispered you
0056 =
H057 = * All in-game commands must be entered to ALL chat!
