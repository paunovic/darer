[commandstext]
H001 = Команды, которые вы должны знать:
0002 = 
C003 = .start
0003 = Начать игру
0004 = 
H005 = Команды клиента:
0006 = 
C007 = /msg, /whisper, /m, /w <name>
0007 = Отправить сообщение игроку
C008 = /ignore <name>
0008 = Добавить игрока в игнорлист -  не сможет с вами общаться
C009 = /unignore <name>
0009 = Снять игнор с игрока
C010 = /who <channel>
0010 = Показать всех пользователей в выбранном канале
C011 = /stats <name>
0011 = Показать основную статистику игрока
C012 = /channel, /join <name of channel>
0012 = Присоединиться к указанному каналу
C013 = /rejoin
0013 = Переподключиться к каналу
C014 = /uptime
0014 = Показать время работы сервера
C015 = /admins
0015 = Показать админов онлайн
C016 = /reply, /r <msg>
0016 = Ответ на последний ПриватМессадж который вы получили
C017 = /ping, /latency, /p <player>
0017 = Показать пинг игрока 
0018 = 
H019 = Команды в лобби игры:
0119 =
C020 = .close <number>
0020 = Закрыть слот
C021 = .closeall
0021 = Закрыть все открытые слоты
C022 = .hold <player>
0022 = Зарезервировать слот для указанного игрока
C023 = .swap <n1> <n2>
0023 = Поменять местами слоты
C024 = .open <number>
0024 = Открыть слот
C025 = .openall
0025 = Открыть все закрытые слоты
C026 = .sp
0026 = Перемешать игроков
C027 = .ss, .sb
0027 = Показать рейтинги
C028 = .ab
0028 = Автобаланс
C029 = .start
0029 = Начать игру
C030 = .stats <name>
0030 = Показать основную статистику игрока
C031 = .ping
0031 = Показать пинг игроков
C032 = .unhost
0032 = Остановить игру
0X33 =
H034 = Команды в игре:
0X34 =
C035 = .ping
0035 = Показать пинг игроков
C036 = .rmk
0036 = Начать голосование за окончание игры без учета какой-либо статистики
C037 = .stats <name>
0037 = Показать основную статистику игрока
C137 = .mute <name>
0137 = Отключение плеера от глобального чата (доступно только для Хоста)
C237 = .unmute <name>
0237 = Снять молчанку с игрока
C038 = .muteall
0038 = Дать молчанку в глобальном чате
C039 = .unmuteall
0039 = Снять молчанку с глобального чата
C040 = .votekick <name>
0040 = Начало голосования за кик для выбранного игрока
C041 = .votecancel
0041 = Отмена голосования за кик для выбранного игрока
C042 = .yes
0042 = Проголосовать за кик для выбранного игрока
C043 = .from
0043 = Показать страну игрока
C044 = .dr <value>
0044 = Показать или установить задержку (50-250)
C055 = /re <msg>
0055 = Ответить последнему кто писал вам в приват
0056 =
H057 = * Все игровые команды необходимо вводить в общий чат!
